# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/taskdb

# Auth -- generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS -- JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Redis (shared instance, different DB indexes to isolate concerns)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Response cache TTL in seconds
CACHE_TTL_SECONDS=60

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Email -- leave SMTP_USER blank to disable sending in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_NAME=Task Manager
