# ============================================================
# Database
# ============================================================
# Format: postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/taskdb

# For testing (SQLite in-memory, no setup needed)
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# ============================================================
# JWT Authentication
# ============================================================
# Generate a strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# CORS (which frontends are allowed to call this API)
# ============================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============================================================
# Email / SMTP (for welcome emails and notifications)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
