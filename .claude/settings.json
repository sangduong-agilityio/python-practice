{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-forbidden-command.py\"",
            "timeout": 10,
            "statusMessage": "block-forbidden-command"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_commit_test_gate.py\"",
            "timeout": 300,
            "statusMessage": "pre-commit-test-gate (ruff + pytest)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_on_edit.py\"",
            "timeout": 30,
            "statusMessage": "format-on-edit"
          }
        ]
      }
    ]
  }
}
