{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: Current Test File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-vv",
                "-s",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "presentation": {
                "group": "Test",
                "order": 1
            }
        },
        {
            "name": "Debug: All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/",
                "-vv",
                "-s",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug: Single Test (Input Name)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/",
                "-vv",
                "-s",
                "-k",
                "${selectedText}",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "presentation": {
                "group": "Test",
                "order": 6
            }
        },
        {
            "name": "Debug: Tests with Coverage",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/",
                "-vv",
                "-s",
                "--cov=src.fastapi_training",
                "--cov-report=term-missing"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "presentation": {
                "group": "Test",
                "order": 7
            }
        },
        {
            "name": "Debug: Auth Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
